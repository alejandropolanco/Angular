# Entorno
NODE_ENV=development
PORT=4000

# Base de datos SQLite (relativa a la raíz del proyecto)
DATABASE_PATH=data/novastore.db

# Administrador inicial. Cambiar en producción.
ADMIN_EMAIL=admin@gmail.com
ADMIN_PASSWORD=1234

# Duración de la sesión en días
SESSION_TTL_DAYS=7

# Orígenes permitidos para solicitudes a /api
ALLOWED_ORIGINS=http://localhost:4200,http://localhost:4000

# Hosts permitidos por el SSR de Angular en producción, además de los de
# `security.allowedHosts` en angular.json. Necesario si el dominio de
# producción no está en esa lista (si no, el SSR responde 400).
# NG_ALLOWED_HOSTS=tudominio.com,www.tudominio.com

# Activar solo detrás de un proxy inverso confiable
# TRUST_PROXY=true
